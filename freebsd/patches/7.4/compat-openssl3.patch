Description: Build and run against OpenSSL 3 (FreeBSD 14/15 base): guard OPENSSL_SSLV23_PADDING (gone in OpenSSL 3), load the legacy provider for RC4 (the default of openssl_seal()), Blowfish, DES, RC2, CAST5 and MD4, and return only the public part from openssl_csr_get_public_key(). No change with OpenSSL 1.1.
Origin: azsupport; padding guard and CSR public key extraction as in php-src PHP-8.1 ext/openssl/openssl.c, provider loading per OSSL_PROVIDER_load(3); tested against OpenSSL 3.5.6

diff --git a/ext/openssl/openssl.c b/ext/openssl/openssl.c
index a443f7bae..5edc4ebe6 100644
--- a/ext/openssl/openssl.c
+++ b/ext/openssl/openssl.c
@@ -55,6 +55,9 @@
 #include <openssl/rand.h>
 #include <openssl/ssl.h>
 #include <openssl/pkcs12.h>
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#include <openssl/provider.h>
+#endif
 
 /* Common */
 #include <time.h>
@@ -1471,6 +1474,30 @@ PHP_MINIT_FUNCTION(openssl)
 	OPENSSL_init_ssl(OPENSSL_INIT_LOAD_CONFIG, NULL);
 #endif
 
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	/* PHP 7.4 relies on algorithms that OpenSSL 3 moved into its "legacy"
+	 * provider: RC4 (the default cipher of openssl_seal()), Blowfish, DES,
+	 * RC2 (openssl_pkcs7_encrypt(), PKCS#12 files), CAST5, MD4 and others.
+	 * Load "legacy", and "default" with it, because loading any provider
+	 * explicitly turns off the implicit loading of "default". This runs after
+	 * OPENSSL_INIT_LOAD_CONFIG, so openssl.cnf still applies first. A missing
+	 * legacy module is not fatal: those algorithms then stay unavailable.
+	 * The static pointers keep a module reload (Apache graceful restart) from
+	 * loading them again; they are never unloaded, as other users of OpenSSL
+	 * in the same process (mod_ssl) may rely on "default". */
+	{
+		static OSSL_PROVIDER *php_openssl_provider_default = NULL;
+		static OSSL_PROVIDER *php_openssl_provider_legacy = NULL;
+		if (!php_openssl_provider_default) {
+			php_openssl_provider_default = OSSL_PROVIDER_load(NULL, "default");
+		}
+		if (!php_openssl_provider_legacy) {
+			php_openssl_provider_legacy = OSSL_PROVIDER_load(NULL, "legacy");
+		}
+		ERR_clear_error();
+	}
+#endif
+
 	/* register a resource id number with OpenSSL so that we can map SSL -> stream structures in
 	 * OpenSSL callbacks */
 	ssl_stream_data_index = SSL_get_ex_new_index(0, "PHP stream index", NULL, NULL, NULL);
@@ -1517,7 +1544,9 @@ PHP_MINIT_FUNCTION(openssl)
 	REGISTER_LONG_CONSTANT("PKCS7_NOSIGS", PKCS7_NOSIGS, CONST_CS|CONST_PERSISTENT);
 
 	REGISTER_LONG_CONSTANT("OPENSSL_PKCS1_PADDING", RSA_PKCS1_PADDING, CONST_CS|CONST_PERSISTENT);
+#ifdef RSA_SSLV23_PADDING
 	REGISTER_LONG_CONSTANT("OPENSSL_SSLV23_PADDING", RSA_SSLV23_PADDING, CONST_CS|CONST_PERSISTENT);
+#endif
 	REGISTER_LONG_CONSTANT("OPENSSL_NO_PADDING", RSA_NO_PADDING, CONST_CS|CONST_PERSISTENT);
 	REGISTER_LONG_CONSTANT("OPENSSL_PKCS1_OAEP_PADDING", RSA_PKCS1_OAEP_PADDING, CONST_CS|CONST_PERSISTENT);
 
@@ -3747,6 +3776,23 @@ PHP_FUNCTION(openssl_csr_get_public_key)
 	/* Retrieve the public key from the CSR */
 	tpubkey = X509_REQ_get_pubkey(csr);
 
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	/* OpenSSL 3 caches the key that was assigned to the CSR, private part
+	 * included, and X509_REQ_dup() copies that cache: the "public" key would
+	 * still hold the private key. Round-trip it through PEM to keep only the
+	 * public part, as PHP 8.1 does (php_openssl_extract_public_key()). */
+	if (tpubkey) {
+		EVP_PKEY *pub_only = NULL;
+		BIO *bio = BIO_new(BIO_s_mem());
+		if (bio && PEM_write_bio_PUBKEY(bio, tpubkey)) {
+			pub_only = PEM_read_bio_PUBKEY(bio, NULL, NULL, NULL);
+		}
+		BIO_free(bio);
+		EVP_PKEY_free(tpubkey);
+		tpubkey = pub_only;
+	}
+#endif
+
 	if (csr != orig_csr) {
 		/* We need to free the duplicated CSR */
 		X509_REQ_free(csr);
