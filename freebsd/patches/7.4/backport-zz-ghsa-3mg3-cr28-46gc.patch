+/* a field of the full status: escaped for the HTML and XML pages, NULL when empty
+ * (GHSA-3mg3-cr28-46gc, as fpm_status_escape() of PHP 8.2.36, without the JSON of 8.x) */
+static char *fpm_status_escape(const char *str, int encode, zend_string **tmp)
+{
+	*tmp = NULL;
+	if (str[0] == '\0') {
+		return NULL;
+	}
+	if (encode) {
+		*tmp = php_escape_html_entities_ex((unsigned char *) str, strlen(str), 1,
+				ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_COMPAT, NULL, /* double_encode */ 1);
+		return ZSTR_VAL(*tmp);
+	}
+	return (char *) str;
+}
