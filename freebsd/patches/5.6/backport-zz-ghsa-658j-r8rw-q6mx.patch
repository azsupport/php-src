Description: GHSA-658j-r8rw-q6mx (CVE-2026-115560, the PHP security release of 19.11.2026): session.upload_progress.enabled is off by default; for 5.6: the default off, rfc1867_enabled reset in GINIT, the guard (a warning and FAILURE, as the other checks of 5.6) in the INI handlers of 5.6 that set the save handler, the serializer, the save path, the name and the hash function, and in OnUpdateSessionLong, OnUpdateSessionString and OnUpdateSessionBool, wrappers of the standard handlers that the long, string and boolean settings of the session take here as in PHP 7.2 and later (gc_*, cookie_*, use_cookies, use_only_cookies, use_strict_mode, referer_check, entropy_*, cache_*, hash_bits_per_character), as the fix guards those; session.auto_start (PHP_INI_PERDIR), use_trans_sid and upload_progress.* not, as there; its tests not taken The default off and the reset of rfc1867_enabled in GINIT are in Remi's branch (f98c3c2b, 17.11.2026); this patch adds the guard.
Origin: php-src commit 3f70f66611583bca4ec18385f7f407e2808fa61f (Arnaud Le Blanc, 09.11.2026, PHP 8.2.36)

diff --git a/ext/session/session.c b/ext/session/session.c
index ff573243..8482aa8c 100644
--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -86,6 +86,12 @@ zend_class_entry *php_session_id_iface_entry;
 		return FAILURE;	\
 	}
 
+#define SESSION_CHECK_UPLOAD_PROGRESS_STATE \
+	if (PS(rfc1867_enabled) && stage == ZEND_INI_STAGE_RUNTIME) { \
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "Session ini settings cannot be changed at runtime when session.upload_progress.enabled is On");	\
+		return FAILURE;	\
+	}
+
 static void php_session_send_cookie(TSRMLS_D);
 
 /* Dispatched by RINIT and by php_session_destroy */
@@ -570,6 +576,7 @@ static void php_session_save_current_state(TSRMLS_D) /* {{{ */
 static PHP_INI_MH(OnUpdateSaveHandler) /* {{{ */
 {
 	ps_module *tmp;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 
 	tmp = _php_find_ps_module(new_value TSRMLS_CC);
@@ -600,6 +607,7 @@ static PHP_INI_MH(OnUpdateSaveHandler) /* {{{ */
 static PHP_INI_MH(OnUpdateSerializer) /* {{{ */
 {
 	const ps_serializer *tmp;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 
 	tmp = _php_find_ps_serializer(new_value TSRMLS_CC);
@@ -641,6 +649,7 @@ static PHP_INI_MH(OnUpdateTransSid) /* {{{ */
 
 static PHP_INI_MH(OnUpdateSaveDir) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	/* Only do the safemode/open_basedir check at runtime */
 	if (stage == PHP_INI_STAGE_RUNTIME || stage == PHP_INI_STAGE_HTACCESS) {
 		char *p;
@@ -672,6 +681,7 @@ static PHP_INI_MH(OnUpdateSaveDir) /* {{{ */
 
 static PHP_INI_MH(OnUpdateName) /* {{{ */
 {
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	/* Numeric session.name won't work at all */
 	if ((!new_value_length || is_numeric_string(new_value, new_value_length, NULL, NULL, 0))) {
 		int err_type;
@@ -699,6 +709,7 @@ static PHP_INI_MH(OnUpdateHashFunc) /* {{{ */
 	long val;
 	char *endptr = NULL;
 
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 #if defined(HAVE_HASH_EXT) && !defined(COMPILE_DL_HASH)
 	PS(hash_ops) = NULL;
 #endif
@@ -782,6 +793,30 @@ static ZEND_INI_MH(OnUpdateSmartStr) /* {{{ */
 }
 /* }}} */
 
+/* the settings of the session that take the standard handlers in 5.6, with the guard of
+ * GHSA-658j-r8rw-q6mx in front of them: as OnUpdateSessionLong, OnUpdateSessionString and
+ * OnUpdateSessionBool of PHP 7.2 and later, whose guard PHP 8.2.36 added there */
+static PHP_INI_MH(OnUpdateSessionLong) /* {{{ */
+{
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
+	return OnUpdateLong(entry, new_value, new_value_length, mh_arg1, mh_arg2, mh_arg3, stage TSRMLS_CC);
+}
+/* }}} */
+
+static PHP_INI_MH(OnUpdateSessionString) /* {{{ */
+{
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
+	return OnUpdateString(entry, new_value, new_value_length, mh_arg1, mh_arg2, mh_arg3, stage TSRMLS_CC);
+}
+/* }}} */
+
+static PHP_INI_MH(OnUpdateSessionBool) /* {{{ */
+{
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
+	return OnUpdateBool(entry, new_value, new_value_length, mh_arg1, mh_arg2, mh_arg3, stage TSRMLS_CC);
+}
+/* }}} */
+
