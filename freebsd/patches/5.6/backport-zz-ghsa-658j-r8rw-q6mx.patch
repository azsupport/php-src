Description: GHSA-658j-r8rw-q6mx (CVE-2026-115560, the PHP security release of 19.11.2026): session.upload_progress.enabled is off by default; for 5.6: the default off, rfc1867_enabled reset in GINIT, the guard (a warning and FAILURE, as the other checks of 5.6) in the INI handlers of 5.6 that set the save handler, the serializer, the save path, the name and the hash function (the other settings of 5.6 take the standard handlers); its tests not taken
Origin: php-src commit 3f70f66611583bca4ec18385f7f407e2808fa61f (Arnaud Le Blanc, 09.11.2026, PHP 8.2.36)

diff --git a/ext/session/session.c b/ext/session/session.c
index 0d1e8a2ee..0ee2bc3ce 100644
--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -86,6 +86,12 @@ zend_class_entry *php_session_id_iface_entry;
 		return FAILURE;	\
 	}
 
+#define SESSION_CHECK_UPLOAD_PROGRESS_STATE \
+	if (PS(rfc1867_enabled) && stage == ZEND_INI_STAGE_RUNTIME) { \
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "Session ini settings cannot be changed at runtime when session.upload_progress.enabled is On");	\
+		return FAILURE;	\
+	}
+
 static void php_session_send_cookie(TSRMLS_D);
 
 /* Dispatched by RINIT and by php_session_destroy */
@@ -570,6 +576,7 @@ static void php_session_save_current_state(TSRMLS_D) /* {{{ */
 static PHP_INI_MH(OnUpdateSaveHandler) /* {{{ */
 {
 	ps_module *tmp;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 
 	tmp = _php_find_ps_module(new_value TSRMLS_CC);
@@ -600,6 +607,7 @@ static PHP_INI_MH(OnUpdateSaveHandler) /* {{{ */
 static PHP_INI_MH(OnUpdateSerializer) /* {{{ */
 {
 	const ps_serializer *tmp;
+	SESSION_CHECK_UPLOAD_PROGRESS_STATE;
 	SESSION_CHECK_ACTIVE_STATE;
 
