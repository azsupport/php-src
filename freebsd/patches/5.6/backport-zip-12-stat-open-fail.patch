Description: GH-23511: fstat() of a zip:// stream succeeded with an empty stat when the archive could not be opened (PHP 8.4.26, not in this branch); brought onto the PHP 5 code of 5.6 by hand; its tests not taken (PHP 7 and later)
Origin: php-src commit 614afe7b09fd37c57f71a02fecfac33191ea141a (David Carlier, 29.08.2026, PHP 8.4.26)

diff --git a/ext/zip/zip_stream.c b/ext/zip/zip_stream.c
index a0a3475..36780df 100644
--- a/ext/zip/zip_stream.c
+++ b/ext/zip/zip_stream.c
@@ -183,6 +183,9 @@ static int php_zip_ops_stat(php_stream *stream, php_stream_statbuf *ssb TSRMLS_D
 		ssb->sb.st_blocks = -1;
 #endif
 		ssb->sb.st_ino = -1;
+	} else {
+		efree(file_basename);
+		return -1;
 	}
 	efree(file_basename);
 	return 0;
