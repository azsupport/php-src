-#endif
 	PHP_FE(imagecrop,								arginfo_imagecrop)
 	PHP_FE(imagecropauto,							arginfo_imagecropauto)
 	PHP_FE(imagescale,								arginfo_imagescale)
@@ -3154,6 +3150,11 @@ PHP_FUNCTION(imageline)
 	if (im->antialias) {
 		gdImageAALine(im, x1, y1, x2, y2, col);
 	} else
+#else
+	if (im->AA) {
+		gdImageSetAntiAliased(im, col);
+		gdImageLine(im, x1, y1, x2, y2, gdAntiAliased);
+	} else
 #endif
 	{
 		gdImageLine(im, x1, y1, x2, y2, col);
@@ -5011,7 +5012,6 @@ PHP_FUNCTION(imageflip)
 }
 /* }}} */
 
-#ifdef HAVE_GD_BUNDLED
 /* {{{ proto bool imageantialias(resource im, bool on)
    Should antialiased functions used or not*/
 PHP_FUNCTION(imageantialias)
@@ -5025,11 +5025,16 @@ PHP_FUNCTION(imageantialias)
 	}
 
 	ZEND_FETCH_RESOURCE(im, gdImagePtr, &IM, -1, "Image", le_gd);
+#ifdef HAVE_GD_BUNDLED
 	gdImageAntialias(im, alias);
+#else
+	if (im->trueColor) {
+		im->AA = alias;
+	}
+#endif
 	RETURN_TRUE;
 }
 /* }}} */
-#endif
 
