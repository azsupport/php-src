Description: DatePeriod::__construct() called again on the same object frees the start, current, end and interval of the first call instead of leaking them (GH-22643), and refuses a DateInterval, or a start or end date, that was not initialized by its constructor (a subclass that overrides it without calling the parent) instead of reading through a NULL pointer; unlike the 7.4 version it restores the error handling mode on that path, so that later warnings do not turn into exceptions.
Origin: php-src commit bbb027263bf9 of the PHP 7.4 security branch of Remi Collet (remicollet/php-src-security PHP-7.4-security-backports) (07.07.2026, Ilija Tovilo), adapted to the PHP 5.6 object layout; the check of the start and end dates is added here (5.6 copies the start time with memcpy())

diff --git a/ext/date/php_date.c b/ext/date/php_date.c
index 801208d7..e18e6b6f 100644
--- a/ext/date/php_date.c
+++ b/ext/date/php_date.c
@@ -4412,6 +4412,30 @@ static int date_period_initialize(timelib_time **st, timelib_time **et, timelib_
 	return retval;
 }
 
+static void date_period_reset(php_period_obj *period_obj) /* {{{ */
+{
+	if (period_obj->start) {
+		timelib_time_dtor(period_obj->start);
+	}
+	if (period_obj->current) {
+		timelib_time_dtor(period_obj->current);
+	}
+	if (period_obj->end) {
+		timelib_time_dtor(period_obj->end);
+	}
+	if (period_obj->interval) {
+		timelib_rel_time_dtor(period_obj->interval);
+	}
+	period_obj->start = NULL;
+	period_obj->start_ce = NULL;
+	period_obj->current = NULL;
+	period_obj->end = NULL;
+	period_obj->interval = NULL;
+	period_obj->recurrences = 0;
+	period_obj->initialized = 0;
+	period_obj->include_start_date = 0;
+} /* }}} */
+
 /* {{{ proto DatePeriod::__construct(DateTime $start, DateInterval $interval, int recurrences|DateTime $end)
    Creates new DatePeriod object.
 */
@@ -4439,7 +4463,7 @@ PHP_METHOD(DatePeriod, __construct)
 	}
 
 	dpobj = zend_object_store_get_object(getThis() TSRMLS_CC);
-	dpobj->current = NULL;
+	date_period_reset(dpobj);
 
 	if (isostr) {
 		date_period_initialize(&(dpobj->start), &(dpobj->end), &(dpobj->interval), &recurrences, isostr, isostr_len TSRMLS_CC);
@@ -4463,9 +4487,19 @@ PHP_METHOD(DatePeriod, __construct)
 	} else {
 		/* init */
 		intobj  = (php_interval_obj *) zend_object_store_get_object(interval TSRMLS_CC);
+		if (!intobj->initialized) {
+			php_error_docref(NULL TSRMLS_CC, E_WARNING, "The DateInterval object has not been correctly initialized by its constructor");
+			zend_restore_error_handling(&error_handling TSRMLS_CC);
+			return;
+		}
+		dateobj = (php_date_obj *) zend_object_store_get_object(start TSRMLS_CC);
+		if (!dateobj->time || (end && !((php_date_obj *) zend_object_store_get_object(end TSRMLS_CC))->time)) {
+			php_error_docref(NULL TSRMLS_CC, E_WARNING, "The DateTimeInterface object has not been correctly initialized by its constructor");
+			zend_restore_error_handling(&error_handling TSRMLS_CC);
+			return;
+		}
 
 		/* start date */
-		dateobj = (php_date_obj *) zend_object_store_get_object(start TSRMLS_CC);
 		clone = timelib_time_ctor();
 		memcpy(clone, dateobj->time, sizeof(timelib_time));
 		if (dateobj->time->tz_abbr) {
diff --git a/ext/date/tests/DatePeriod_double_constructor_call.phpt b/ext/date/tests/DatePeriod_double_constructor_call.phpt
new file mode 100644
index 00000000..cd3ed44b
--- /dev/null
+++ b/ext/date/tests/DatePeriod_double_constructor_call.phpt
@@ -0,0 +1,16 @@
+--TEST--
+Double DatePeriod::__construct() call
+--INI--
+date.timezone=UTC
+--FILE--
+<?php
+
+$start = new \DateTime();
+$interval = new \DateInterval('P1D');
+$period = new \DatePeriod($start, $interval, 1);
+$period->__construct($start, $interval, 1);
+
+?>
+===DONE===
+--EXPECT--
+===DONE===
diff --git a/ext/date/tests/DatePeriod_uninitialized_arguments.phpt b/ext/date/tests/DatePeriod_uninitialized_arguments.phpt
new file mode 100644
index 00000000..629098f1
--- /dev/null
+++ b/ext/date/tests/DatePeriod_uninitialized_arguments.phpt
@@ -0,0 +1,31 @@
+--TEST--
+DatePeriod::__construct() with a DateInterval or DateTime that was not initialized
+--INI--
+date.timezone=UTC
+--FILE--
+<?php
+class I extends DateInterval { function __construct() {} }
+class D extends DateTime { function __construct() {} }
+
+foreach (array(
+	function () { return new DatePeriod(new DateTime('2026-01-01'), new I, 1); },
+	function () { return new DatePeriod(new D, new DateInterval('P1D'), 1); },
+	function () { return new DatePeriod(new DateTime('2026-01-01'), new DateInterval('P1D'), new D); },
+) as $f) {
+	try {
+		$f();
+		echo "no exception\n";
+	} catch (Exception $e) {
+		echo get_class($e), ": ", $e->getMessage(), "\n";
+	}
+}
+/* the error handling mode of the constructor must not leak out of it */
+echo $undefined_variable, "after\n";
+?>
+--EXPECTF--
+Exception: DatePeriod::__construct(): The DateInterval object has not been correctly initialized by its constructor
+Exception: DatePeriod::__construct(): The DateTimeInterface object has not been correctly initialized by its constructor
+Exception: DatePeriod::__construct(): The DateTimeInterface object has not been correctly initialized by its constructor
+
+Notice: Undefined variable: undefined_variable in %s on line %d
+after
