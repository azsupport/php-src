--- a/ext/standard/dl.c
+++ b/ext/standard/dl.c
@@ -99,6 +99,27 @@ PHPAPI PHP_FUNCTION(dl)
 
 /* {{{ php_load_extension
  */
+#ifdef PHP_NO_EXTENSION_LOADING
+/* Is the extension a line names (mysqli, mysqli.so, /path/mysqli.so) built in? */
+static int php_builtin_extension(const char *filename)
+{
+	const char *base = strrchr(filename, '/');
+	char name[128];
+	size_t len;
+
+	base = base ? base + 1 : filename;
+	len = strlen(base);
+	if (len > 3 && strcmp(base + len - 3, ".so") == 0) {
+		len -= 3;
+	}
+	if (len == 0 || len >= sizeof(name)) {
+		return 0;
+	}
+	zend_str_tolower_copy(name, base, len);
+	return zend_hash_exists(&module_registry, name, len + 1);
+}
+#endif
+
 PHPAPI int php_load_extension(char *filename, int type, int start_now TSRMLS_DC)
