+	if (UNEXPECTED(length < min_length)) {
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "Malformed server packet. Field length is too short for the field type");
+		*row = NULL;
+		return 1;
+	}
+	return 0;
