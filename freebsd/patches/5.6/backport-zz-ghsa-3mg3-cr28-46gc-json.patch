Description: GHSA-3mg3-cr28-46gc (CVE-2026-129292, the PHP security release of 19.11.2026): FPM XSS within status endpoint via user and script; the fix on Remi Collet's branch (f98c3c2b) escapes the request method, the URI, the query string, the user and the script for the HTML and XML pages only, and the JSON page gave them raw (a quote in the user made it invalid JSON); for 5.6 these five fields escaped for the JSON page too, by an escaper of its own that writes them as php_json_encode_string() of 8.x does with PHP_JSON_INVALID_UTF8_IGNORE (the json of 5.6 can be a module of its own, which FPM cannot call), as for 7.4; the JSON part of our backport of 20.11.2026, which the move onto f98c3c2b dropped (21.11.2026); its tests not taken
Origin: php-src commit 1ecb92f2cdeb235bb10d6c220c9be4a13f527243 (Jakub Zelenka, 26.10.2026, PHP 8.2.36): its escaping of the JSON page

diff --git a/sapi/fpm/fpm/fpm_status.c b/sapi/fpm/fpm/fpm_status.c
--- a/sapi/fpm/fpm/fpm_status.c
+++ b/sapi/fpm/fpm/fpm_status.c
@@ -16,6 +16,7 @@
 #include "fpm_conf.h"
 #include "fpm_php.h"
 #include <ext/standard/html.h>
+#include <ext/standard/php_smart_str.h>
 
 static char *fpm_status_uri = NULL;
 static char *fpm_status_ping_uri = NULL;
@@ -46,6 +47,78 @@
 }
 /* }}} */
 
+/* a field for the JSON page as php_json_encode_string() of PHP 8.2.36 writes it with
+ * PHP_JSON_INVALID_UTF8_IGNORE, without its quotes: " \ / and the control characters
+ * escaped, every character past ASCII as \uXXXX (UTF-16), the bytes that are not
+ * UTF-8 left out; the json of 5.6 is a module of its own, which FPM cannot call */
+static char *fpm_status_json_escape(const char *str)
+{
+	static const char digits[] = "0123456789abcdef";
+	size_t len = strlen(str), pos = 0;
+	smart_str buf = {0};
+
+	while (pos < len) {
+		int status;
+		unsigned int us = php_next_utf8_char((const unsigned char *) str, len, &pos, &status);
+
+		if (status != SUCCESS) {
+			continue;
+		}
+		switch (us) {
+			case '"':
+				smart_str_appendl(&buf, "\\\"", 2);
+				break;
+			case '\\':
+				smart_str_appendl(&buf, "\\\\", 2);
+				break;
+			case '/':
+				smart_str_appendl(&buf, "\\/", 2);
+				break;
+			case '\b':
+				smart_str_appendl(&buf, "\\b", 2);
+				break;
+			case '\f':
+				smart_str_appendl(&buf, "\\f", 2);
+				break;
+			case '\n':
+				smart_str_appendl(&buf, "\\n", 2);
+				break;
+			case '\r':
+				smart_str_appendl(&buf, "\\r", 2);
+				break;
+			case '\t':
+				smart_str_appendl(&buf, "\\t", 2);
+				break;
+			default:
+				if (us >= 0x20 && us < 0x80) {
+					smart_str_appendc(&buf, (char) us);
+				} else {
+					unsigned int units[2];
+					int n = 1, i;
+
+					units[0] = us;
+					if (us >= 0x10000) {
+						us -= 0x10000;
+						units[0] = 0xd800 | (us >> 10);
+						units[1] = 0xdc00 | (us & 0x3ff);
+						n = 2;
+					}
+					for (i = 0; i < n; i++) {
+						smart_str_appendl(&buf, "\\u", 2);
+						smart_str_appendc(&buf, digits[(units[i] >> 12) & 0xf]);
+						smart_str_appendc(&buf, digits[(units[i] >> 8) & 0xf]);
+						smart_str_appendc(&buf, digits[(units[i] >> 4) & 0xf]);
+						smart_str_appendc(&buf, digits[units[i] & 0xf]);
+					}
+				}
+				break;
+		}
+	}
+	smart_str_0(&buf);
+	return buf.c ? buf.c : estrdup("");
+}
+
+/* encode: 0 as it is, 1 for the HTML and XML pages, 2 for the JSON page */
 static char *fpm_status_escape(char *str, int encode, char **tmp TSRMLS_DC)
 {
 	size_t len;
@@ -54,6 +127,10 @@
 	if (str[0] == '\0') {
 		return NULL;
 	}
+	if (encode == 2) {
+		*tmp = fpm_status_json_escape(str);
+		return *tmp;
+	}
 	if (encode) {
 		*tmp = php_escape_html_entities_ex((unsigned char *) str, strlen(str), &len, 1,
 				ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_COMPAT, NULL, /* double_encode */ 1 TSRMLS_CC);
@@ -278,6 +355,7 @@
 		} else if (fpm_php_get_string_from_table("_GET", "json" TSRMLS_CC)) {
 			sapi_add_header_ex(ZEND_STRL("Content-Type: application/json"), 1, 1 TSRMLS_CC);
 			time_format = "%s";
+			encode = 2;
 
 			short_syntax =
 				"{"
