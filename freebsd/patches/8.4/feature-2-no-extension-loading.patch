Description: PHP loads no extensions at run time: extension= and zend_extension= lines, dl() and php -z are refused with a warning that names the file, a line for an extension that is built in (extension=mysqli) is skipped quietly, phpinfo() shows "Dynamic Library Support: disabled", and configure stops when an extension would be built as .so (OPcache: --enable-opcache-static). Without the option nothing changes.
Option: --disable-extension-loading
Origin: azsupport

diff --git a/Zend/zend_extensions.c b/Zend/zend_extensions.c
index fecea4fa0..c897da1db 100644
--- a/Zend/zend_extensions.c
+++ b/Zend/zend_extensions.c
@@ -28,6 +28,11 @@ static int last_resource_number;
 
 zend_result zend_load_extension(const char *path)
 {
+#ifdef PHP_NO_EXTENSION_LOADING
+	/* --disable-extension-loading (azsupport/php-src), also for php -z */
+	fprintf(stderr, "Cannot load %s: this PHP loads no extensions at run time (--disable-extension-loading)\n", path);
+	return FAILURE;
+#endif
 #if ZEND_EXTENSIONS_SUPPORT
 	DL_HANDLE handle;
 
