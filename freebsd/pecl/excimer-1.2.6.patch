Description: Build inside php-src as ext/excimer (bundled by this fork): pass -fvisibility=hidden for the excimer sources only; config.m4 added it to CFLAGS, which inside php-src is that of the whole build.
Origin: azsupport

--- a/config.m4
+++ b/config.m4
@@ -41,9 +41,11 @@
     PHP_EVAL_LIBLINE($LIBS, EXCIMER_SHARED_LIBADD)
   ])
 
-  dnl Avoid exporting symbols unnecessarily
+  dnl Avoid exporting symbols unnecessarily: for the excimer sources only, as
+  dnl inside php-src CFLAGS is that of the whole build.
+  EXCIMER_CFLAGS=
   AX_CHECK_COMPILE_FLAG([-fvisibility=hidden],
-    [CFLAGS="$CFLAGS -fvisibility=hidden"])
+    [EXCIMER_CFLAGS="-fvisibility=hidden"])
 
   PHP_SUBST(EXCIMER_SHARED_LIBADD)
   PHP_NEW_EXTENSION(excimer, excimer.c \
@@ -51,7 +53,7 @@
     excimer_timer.c \
     excimer_log.c \
     timerlib/timerlib_common.c \
-    $excimer_os_sources, $ext_shared)
+    $excimer_os_sources, $ext_shared,, $EXCIMER_CFLAGS)
 
   dnl Create build directory (T394738)
   PHP_ADD_BUILD_DIR([$ext_builddir/timerlib])
