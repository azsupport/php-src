Description: Build inside php-src as ext/swoole (bundled by this fork): the default of --enable-swoole was "yes", which built it into every PHP configured without --disable-all; it is now "no"; drop the option --enable-openssl, which reset PHP_OPENSSL of --with-openssl to "no" so that mysqlnd built without its OpenSSL code (swoole now uses OpenSSL when PHP is built --with-openssl, as swoole 6.2 does); drop the -std=c++14 that config.m4 appends to CXXFLAGS, which inside php-src applies to every C++ file and overrides the C++17 that ext/intl needs with ICU 75 and newer.
Origin: azsupport

--- a/config.m4
+++ b/config.m4
@@ -31,15 +31,17 @@
   [AS_HELP_STRING([--enable-sockets],
     [Do you have sockets extension?])], [no], [no])
 
-PHP_ARG_ENABLE([openssl],
-  [enable openssl support],
-  [AS_HELP_STRING([--enable-openssl],
-    [Use openssl])], [no], [no])
+dnl Inside php-src the option --enable-openssl of swoole sets PHP_OPENSSL, the
+dnl variable of --with-openssl, back to "no" when it is not given, and mysqlnd
+dnl (config9.m4) then builds without its OpenSSL code. Without it, swoole uses
+dnl OpenSSL when PHP is built --with-openssl, as swoole 6.2 does.
 
 PHP_ARG_ENABLE([swoole],
   [swoole support],
   [AS_HELP_STRING([--enable-swoole],
-    [Enable swoole support])], [enable_swoole="yes"])
+    [Enable swoole support])], [no])
+dnl The default was enable_swoole="yes": inside php-src that built swoole into every
+dnl PHP configured without --disable-all. Now only --enable-swoole builds it.
 
 PHP_ARG_ENABLE([mysqlnd],
   [enable mysqlnd support],
@@ -1395,11 +1397,9 @@
 
     CXXFLAGS="$CXXFLAGS -Wall -Wno-date-time -Wno-unused-function -Wno-deprecated -Wno-deprecated-declarations"
 
-    if test "$SW_OS" = "CYGWIN" || test "$SW_OS" = "MINGW"; then
-        CXXFLAGS="$CXXFLAGS -std=gnu++14"
-    else
-        CXXFLAGS="$CXXFLAGS -std=c++14"
-    fi
+    dnl Inside php-src CXXFLAGS is shared by all C++ code, and a -std=c++14 at its
+    dnl end would win over the C++17 that ext/intl needs with ICU 75 and newer: the
+    dnl compiler default (gnu++17 since clang 16) or a -std in CXXFLAGS applies.
 
     if test "$SW_CPU" = "arm"; then
         PHP_ADD_LIBRARY(atomic, 1, SWOOLE_SHARED_LIBADD)
