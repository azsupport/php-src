Description: Build inside php-src as ext/excimer (bundled by this fork) and on FreeBSD: pass -fvisibility=hidden for the excimer sources only (config.m4 added it to CFLAGS, which inside php-src is that of the whole build); on FreeBSD take the thread id for SIGEV_THREAD_ID from pthread_getthreadid_np(), as FreeBSD has neither gettid() nor SYS_gettid, so the timer backend of 1.2.4 and later did not compile there (the FreeBSD port devel/pecl-excimer stays at 1.2.3).
Origin: azsupport; pthread_getthreadid_np(3) and SIGEV_THREAD_ID (sigev_notify_thread_id) as in FreeBSD 15.1 include/pthread_np.h and sys/sys/signal.h

--- a/config.m4
+++ b/config.m4
@@ -41,9 +41,11 @@
     PHP_EVAL_LIBLINE($LIBS, EXCIMER_SHARED_LIBADD)
   ])
 
-  dnl Avoid exporting symbols unnecessarily
+  dnl Avoid exporting symbols unnecessarily: for the excimer sources only, as
+  dnl inside php-src CFLAGS is that of the whole build.
+  EXCIMER_CFLAGS=
   AX_CHECK_COMPILE_FLAG([-fvisibility=hidden],
-    [CFLAGS="$CFLAGS -fvisibility=hidden"])
+    [EXCIMER_CFLAGS="-fvisibility=hidden"])
 
   PHP_SUBST(EXCIMER_SHARED_LIBADD)
   PHP_NEW_EXTENSION(excimer, excimer.c \
@@ -51,7 +53,7 @@
     excimer_timer.c \
     excimer_log.c \
     timerlib/timerlib_common.c \
-    $excimer_os_sources, $ext_shared)
+    $excimer_os_sources, $ext_shared,, $EXCIMER_CFLAGS)
 
   dnl Create build directory (T394738)
   PHP_ADD_BUILD_DIR([$ext_builddir/timerlib])
--- a/timerlib/timerlib_posix.c
+++ b/timerlib/timerlib_posix.c
@@ -58,8 +58,15 @@
 #endif
 
 #ifndef HAVE_GETTID
-#include <sys/syscall.h>
-#define gettid() ((pid_t)syscall(SYS_gettid))
+# ifdef __FreeBSD__
+/* FreeBSD has no gettid() and no SYS_gettid. SIGEV_THREAD_ID takes the kernel
+ * thread id (lwpid_t), which is what pthread_getthreadid_np() returns. */
+#  include <pthread_np.h>
+#  define gettid() ((pid_t)pthread_getthreadid_np())
+# else
+#  include <sys/syscall.h>
+#  define gettid() ((pid_t)syscall(SYS_gettid))
+# endif
 #endif
 
 #include "timerlib_pthread_mutex.h"
