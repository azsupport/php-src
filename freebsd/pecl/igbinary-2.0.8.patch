Description: Take the PHP version from the source tree when built inside php-src: the check read $phpincludedir/main/php_version.h of an installed PHP, found none, took PHP 7 and compiled src/php7 for PHP 5.6 (unknown type name zend_string).
Origin: azsupport; igbinary 3.x does the same with $abs_srcdir as the fallback

--- a/config.m4
+++ b/config.m4
@@ -22,8 +22,14 @@
 
   AC_MSG_CHECKING(PHP version)
 
+  dnl Built inside php-src: the version header of this tree, not an installed one.
+  if test -f "$abs_srcdir/main/php_version.h"; then
+    IGBINARY_PHPINCLUDEDIR=$abs_srcdir
+  else
+    IGBINARY_PHPINCLUDEDIR=$phpincludedir
+  fi
   AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
-  #include <$phpincludedir/main/php_version.h>
+  #include <$IGBINARY_PHPINCLUDEDIR/main/php_version.h>
   ]], [[
 #if PHP_MAJOR_VERSION > 5
 #error PHP > 5
