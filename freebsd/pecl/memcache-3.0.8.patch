diff --git a/memcache_queue.h b/memcache_queue.h
index 6bc2edc..a9eebbb 100644
--- a/memcache_queue.h
+++ b/memcache_queue.h
@@ -37,11 +37,9 @@ typedef struct mmc_queue {
