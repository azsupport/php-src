Description: Build inside php-src as ext/swoole (bundled by this fork): the default of --enable-swoole was "yes", which built it into every PHP configured without --disable-all; it is now "no"; drop the -std=c++14 that config.m4 appends to CXXFLAGS, which inside php-src applies to every C++ file and overrides the C++17 that ext/intl needs with ICU 75 and newer. Also usleep() for sw_usleep() in src/core/misc.cc, which is declared nowhere: FreeBSD has no futex and compiles this branch (the fix of the FreeBSD port devel/php-swoole).
Origin: azsupport; the misc.cc fix as in FreeBSD ports devel/php-swoole (files/patch-src_core_misc.cc)

--- a/config.m4
+++ b/config.m4
@@ -34,7 +34,9 @@
 PHP_ARG_ENABLE([swoole],
   [swoole support],
   [AS_HELP_STRING([--enable-swoole],
-    [Enable swoole support])], [enable_swoole="yes"])
+    [Enable swoole support])], [no])
+dnl The default was enable_swoole="yes": inside php-src that built swoole into every
+dnl PHP configured without --disable-all. Now only --enable-swoole builds it.
 
 PHP_ARG_ENABLE([mysqlnd],
   [enable mysqlnd support],
@@ -1563,11 +1565,9 @@
 
     CXXFLAGS="$CXXFLAGS -Wall -Wno-date-time -Wno-unused-function -Wno-deprecated -Wno-deprecated-declarations"
 
-    if test "$SW_OS" = "CYGWIN" || test "$SW_OS" = "MINGW"; then
-        CXXFLAGS="$CXXFLAGS -std=gnu++14"
-    else
-        CXXFLAGS="$CXXFLAGS -std=c++14"
-    fi
+    dnl Inside php-src CXXFLAGS is shared by all C++ code, and a -std=c++14 at its
+    dnl end would win over the C++17 that ext/intl needs with ICU 75 and newer: the
+    dnl compiler default (gnu++17 since clang 16) or a -std in CXXFLAGS applies.
 
     if test "$SW_CPU" = "arm"; then
         PHP_ADD_LIBRARY(atomic, 1, SWOOLE_SHARED_LIBADD)
--- a/src/core/misc.cc
+++ b/src/core/misc.cc
@@ -172,7 +172,7 @@
                 return -1;
             }
         } while (0);
-        sw_usleep(1000);
+        usleep(1000); /* sw_usleep() is declared nowhere: this branch (no futex) is the one FreeBSD builds */
     }
 }
 
