<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED "">
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED "">
  <!ATTLIST policy domain NMTOKEN #REQUIRED>
  <!ATTLIST policy name NMTOKEN #IMPLIED>
  <!ATTLIST policy pattern CDATA #IMPLIED>
  <!ATTLIST policy rights NMTOKEN #IMPLIED>
  <!ATTLIST policy stealth NMTOKEN #IMPLIED>
  <!ATTLIST policy value CDATA #IMPLIED>
]>
<!--
  The policy of /usr/local/imagemagick6 and /usr/local/imagemagick7
  (freebsd/imagemagick.conf, tools/build-imagemagick.sh installs it as
  etc/ImageMagick-6/policy.xml and etc/ImageMagick-7/policy.xml).

  It is the "websafe" policy of ImageMagick (config/policy-websafe.xml of 7.1.2-25
  and 6.9.13-50, the same in both) with the formats of the video sites and room
  for the photos of phones:
  - read and write JPEG, PNG, WebP, GIF, HEIC and AVIF (module HEIC), nothing else
    from files (not BMP and TIFF of websafe; not MNG and JNG, which are in the
    module PNG); make images with xc:, canvas:, label: and caption: (text);
    write INFO and JSON (identify output), MPC (the pixel cache) unseen. A module
    is allowed with "read | write": the programs are built without loadable
    modules, and a built-in module is registered only when the policy gives it
    both rights (RegisterStaticModules of MagickCore/static.c), so websafe's
    write-only INFO and JSON would not be there at all; XC, LABEL, CAPTION have
    no writer and INFO, JSON no reader anyway;
  - no delegate programs (Ghostscript, ffmpeg and the like), no filter modules;
  - no reading through a file descriptor, from /etc or above a directory (../),
    no @file (a file read as a list of names or as the text of label:), no
    standard input and output ("-");
  - limits: images up to 20000 pixels wide and high (a 200 MP photo is 16320
    wide), up to 128 MP of pixels in memory (more goes to disk), 1 GiB of memory,
    2 GiB of mapped files, 4 GiB of disk, 512 frames, 2 threads, 120 seconds.
-->
<policymap>
  <policy domain="resource" name="thread" value="2"/>
  <policy domain="resource" name="time" value="120"/>
  <policy domain="resource" name="file" value="768"/>
  <policy domain="resource" name="memory" value="1GiB"/>
  <policy domain="resource" name="map" value="2GiB"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="disk" value="4GiB"/>
  <policy domain="resource" name="list-length" value="512"/>
  <policy domain="resource" name="width" value="20KP"/>
  <policy domain="resource" name="height" value="20KP"/>
  <policy domain="resource" name="dynamic-throttle" value="true"/>
  <policy domain="cache" name="memory-map" value="anonymous"/>
  <policy domain="cache" name="synchronize" value="true"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="-"/>
  <policy domain="path" rights="none" pattern="fd:*"/>
  <policy domain="path" rights="none" pattern="/etc/*"/>
  <policy domain="path" rights="none" pattern="*../*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="module" rights="none" pattern="*"/>
  <policy domain="module" rights="read | write" pattern="{GIF,JPEG,PNG,WEBP,HEIC,XC,LABEL,CAPTION,INFO,JSON}"/>
  <policy domain="module" rights="read | write" pattern="{MPC}" stealth="true"/>
  <policy domain="coder" rights="none" pattern="{MNG,JNG}"/>
  <policy domain="system" name="shred" value="1"/>
  <policy domain="system" name="memory-map" value="anonymous"/>
  <policy domain="system" name="max-memory-request" value="512MiB"/>
</policymap>
