concat demuxer only with -f concat: no read_probe, so that a file whose content
is a concat script (an upload named video.mp4) is not taken for one and cannot
make FFmpeg read the files it names. remote_cron.php of KVS joins with -f concat.

--- a/libavformat/concatdec.c
+++ b/libavformat/concatdec.c
@@ -76,12 +76,6 @@
     int recursion_depth;
 } ConcatContext;
 
-static int concat_probe(const AVProbeData *probe)
-{
-    return memcmp(probe->buf, "ffconcat version 1.0", 20) ?
-           0 : AVPROBE_SCORE_MAX;
-}
-
 static char *get_keyword(uint8_t **cursor)
 {
     char *ret = *cursor += strspn(*cursor, SPACE_CHARS);
@@ -972,7 +966,10 @@
     .p.priv_class   = &concat_class,
     .priv_data_size = sizeof(ConcatContext),
     .flags_internal = FF_INFMT_FLAG_INIT_CLEANUP,
-    .read_probe     = concat_probe,
+    /* No read_probe: the demuxer is used only when it is asked for (-f concat).
+     * A file that begins as a concat script ("ffconcat version 1.0"), such as
+     * an upload named video.mp4, is not taken for one, so that it cannot make
+     * FFmpeg read the files it names. */
     .read_header    = concat_read_header,
     .read_packet    = concat_read_packet,
     .read_close     = concat_read_close,
